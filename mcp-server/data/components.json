[
  {
    "name": "Button",
    "category": "General",
    "module": "NgcButtonModule",
    "selector": "button[ngcButton], button[ngcBasicButton], button[ngcOutlineButton]",
    "description": "Modern interactive button with multiple appearance styles (primary, outline, basic, danger) and sizes.",
    "inputs": [
      {
        "name": "color",
        "type": "string",
        "default": "primary",
        "description": "Color theme: primary, danger, success, default"
      },
      {
        "name": "disabled",
        "type": "boolean",
        "default": "false",
        "description": "Whether the button is disabled"
      },
      {
        "name": "size",
        "type": "sm | md | lg",
        "default": "md",
        "description": "Button size dimensions"
      }
    ],
    "outputs": [
      {
        "name": "click",
        "type": "EventEmitter<MouseEvent>",
        "description": "Fired when clicked"
      }
    ],
    "templateExample": "<button ngcButton color=\"primary\" (click)=\"onAction()\">Submit</button>\n<button ngcOutlineButton color=\"default\">Cancel</button>",
    "tsExample": "import { NgcButtonModule } from \"ngc-library\";\n\n@Component({\n  imports: [NgcButtonModule],\n  templateUrl: \"./example.component.html\"\n})\nexport class ExampleComponent {\n  onAction() { console.log(\"Clicked\"); }\n}"
  },
  {
    "name": "Alert",
    "category": "Feedback",
    "module": "NgcAlertModule",
    "selector": "ngc-alert",
    "description": "Alert banner for displaying important status, warnings, errors, and system feedback.",
    "inputs": [
      {
        "name": "type",
        "type": "info | success | warning | danger",
        "default": "info",
        "description": "Severity type of alert"
      },
      {
        "name": "title",
        "type": "string",
        "default": "\"\"",
        "description": "Alert headline title"
      },
      {
        "name": "dismissible",
        "type": "boolean",
        "default": "true",
        "description": "Show close/dismiss button"
      }
    ],
    "outputs": [
      {
        "name": "close",
        "type": "EventEmitter<void>",
        "description": "Fired when dismissed"
      }
    ],
    "templateExample": "<ngc-alert type=\"warning\" title=\"Warning Notice\" [dismissible]=\"true\">\n  Please verify your settings before proceeding.\n</ngc-alert>",
    "tsExample": "import { NgcAlertModule } from \"ngc-library\";"
  },
  {
    "name": "Accordion",
    "category": "Layout",
    "module": "NgcExpansionPanelModule",
    "selector": "ngc-expansion-panel, ngc-expansion-panel-header",
    "description": "Collapsible accordion panels with custom headers, toggles, and expandable content bodies.",
    "inputs": [
      {
        "name": "expanded",
        "type": "boolean",
        "default": "false",
        "description": "Initial expand state"
      },
      {
        "name": "disabled",
        "type": "boolean",
        "default": "false",
        "description": "Prevent toggling"
      }
    ],
    "outputs": [
      {
        "name": "opened",
        "type": "EventEmitter<void>",
        "description": "Fired when opened"
      },
      {
        "name": "closed",
        "type": "EventEmitter<void>",
        "description": "Fired when closed"
      }
    ],
    "templateExample": "<ngc-expansion-panel [expanded]=\"true\">\n  <ngc-expansion-panel-header>Panel Title</ngc-expansion-panel-header>\n  <p>Panel content body...</p>\n</ngc-expansion-panel>",
    "tsExample": "import { NgcExpansionPanelModule } from \"ngc-library\";"
  },
  {
    "name": "Card",
    "category": "Data Display",
    "module": "NgcCardModule",
    "selector": "ngc-card, ngc-card-header, ngc-card-content, ngc-card-footer",
    "description": "Card container with header, content body, actions, and customizable elevation borders.",
    "inputs": [
      {
        "name": "elevation",
        "type": "number",
        "default": "1",
        "description": "Shadow depth (0-4)"
      },
      {
        "name": "bordered",
        "type": "boolean",
        "default": "true",
        "description": "Show card border"
      }
    ],
    "outputs": [],
    "templateExample": "<ngc-card>\n  <div class=\"ngc-card__header\">Card Title</div>\n  <div class=\"ngc-card__body\">Card description and details.</div>\n  <div class=\"ngc-card__footer\">\n    <button ngcButton>Action</button>\n  </div>\n</ngc-card>",
    "tsExample": "import { NgcCardModule } from \"ngc-library\";"
  },
  {
    "name": "Data Table",
    "category": "Data Display",
    "module": "NGCTableModule",
    "selector": "ngc-table, ngc-cdk-table",
    "description": "High performance data table with sorting, filtering, row selection, virtual scrolling and pagination.",
    "inputs": [
      {
        "name": "dataSource",
        "type": "any[] | NgcCdkTableDataSource",
        "default": "[]",
        "description": "Table rows data"
      },
      {
        "name": "columns",
        "type": "string[]",
        "default": "[]",
        "description": "Displayed column keys"
      }
    ],
    "outputs": [
      {
        "name": "rowClick",
        "type": "EventEmitter<any>",
        "description": "Fired on row click"
      }
    ],
    "templateExample": "<ngc-table [dataSource]=\"users\">\n  <!-- column templates -->\n</ngc-table>",
    "tsExample": "import { NGCTableModule } from \"ngc-library\";"
  },
  {
    "name": "Dialog",
    "category": "Feedback",
    "module": "NgcDialogModule",
    "selector": "NgcDialogService",
    "description": "Programmatic modal dialog service to open popup windows, forms, and custom components.",
    "inputs": [],
    "outputs": [],
    "templateExample": "<!-- Opened via NgcDialogService in TypeScript -->",
    "tsExample": "import { NgcDialogService } from \"ngc-library\";\n\nconstructor(private dialog: NgcDialogService) {}\n\nopenModal() {\n  this.dialog.open(MyDialogComponent, { width: \"450px\" });\n}"
  },
  {
    "name": "Date Picker",
    "category": "Data Entry",
    "module": "NgcDatePickerModule",
    "selector": "ngc-date-picker",
    "description": "Calendar date picker supporting single date, range selection, time picker, and formats.",
    "inputs": [
      {
        "name": "ngModel",
        "type": "Moment | string",
        "default": "null",
        "description": "Two-way date binding"
      },
      {
        "name": "minDate",
        "type": "Moment",
        "default": "null",
        "description": "Earliest selectable date"
      },
      {
        "name": "maxDate",
        "type": "Moment",
        "default": "null",
        "description": "Latest selectable date"
      }
    ],
    "outputs": [
      {
        "name": "ngModelChange",
        "type": "EventEmitter<Moment>",
        "description": "Fired when date changes"
      }
    ],
    "templateExample": "<ngc-date-picker [(ngModel)]=\"selectedDate\" placeholder=\"Select date\"></ngc-date-picker>",
    "tsExample": "import { NgcDatePickerModule } from \"ngc-library\";"
  },
  {
    "name": "Toast",
    "category": "Feedback",
    "module": "NgcToastModule",
    "selector": "NgcToastService",
    "description": "Global notification toast service supporting success, info, warning, and error alerts.",
    "inputs": [],
    "outputs": [],
    "templateExample": "<!-- Triggered via NgcToastService in TypeScript -->",
    "tsExample": "import { NgcToastService } from \"ngc-library\";\n\nconstructor(private toast: NgcToastService) {}\n\nnotify() {\n  this.toast.show(\"Saved!\", \"Your changes were saved successfully.\", { type: \"success\" });\n}"
  },
  {
    "name": "Form Field",
